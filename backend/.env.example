# Copy to .env and fill in for local development.
# NEVER commit the real .env file (it is already in .gitignore).

# --- Gonka Router (https://gonkarouter.io) ---
# Get your free hackathon key from the Gonka Router dashboard / Discord.
GONKA_API_KEY=sk-REPLACE_ME
GONKA_BASE_URL=https://api.gonkarouter.io
GONKA_CHAT_PATH=/v1/chat/completions
GONKA_RECEIPT_PATH=/v1/receipts/{request_id}

# Pinned verifier models. Confirm exact IDs at https://gonkarouter.io/models
# (or GET /v1/models with your key) before every demo -- provider model
# catalogues change during the event. GONKA_MODEL_A is confirmed against the
# team's own Gonka dashboard example as of 2 Sep 2026; GONKA_MODEL_B has not
# been independently confirmed the same way -- verify it before the demo.
GONKA_MODEL_A=deepseek-ai/DeepSeek-V4-Flash-0731
GONKA_MODEL_A_LABEL=DeepSeek
GONKA_MODEL_B=MiniMaxAI/MiniMax-M2.7
GONKA_MODEL_B_LABEL=MiniMax

# When true, no live Gonka Router calls are made -- the backend returns
# deterministic, clearly-labelled mock verification data instead. Useful for
# frontend development, CI and offline demo rehearsal. NEVER set true for the
# submitted / judged deployment.
GONKA_MOCK_MODE=true

# Comma-separated list of origins allowed to call this API in production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Request budget guards.
# Decentralized inference is slower than a single hosted endpoint and both
# pinned models are reasoning-capable, so these are deliberately generous.
# frontend/lib/api.ts's DEFAULT_TIMEOUT_MS must stay above the worst case here.
GONKA_TIMEOUT_SECONDS=45
GONKA_MAX_RETRIES=1
# Reasoning tokens count toward this -- too low truncates the JSON answer.
GONKA_MAX_TOKENS=2000
MAX_INPUT_CHARS=4000
MAX_IMAGE_BYTES=8000000

# --- Local OCR (screenshot mode only) ---
# Leave both blank when `tesseract` is on PATH with the chi_sim pack installed
# (Debian: tesseract-ocr tesseract-ocr-chi-sim; or use backend/Dockerfile).
# On Windows the UB-Mannheim installer does NOT add itself to PATH and ships
# English only, and its tessdata folder is not writable without admin. Point
# at the binary and at a user-owned tessdata folder holding eng/osd/chi_sim:
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#   TESSDATA_DIR=C:\Users\<you>\tessdata
TESSERACT_CMD=
TESSDATA_DIR=
